# Copiar a .env y ajustar antes de usar en producción
APP_PORT=8080
TZ=America/Asuncion
DB_PASSWORD=cambiar-esta-clave
# Mínimo 32 caracteres. Generar con: openssl rand -base64 48
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio-de-al-menos-32-bytes
# Solo se usa la primera vez (si la base no tiene usuarios)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
